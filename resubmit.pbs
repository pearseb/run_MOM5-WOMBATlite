#!/bin/sh
#PBS -P v19
#PBS -q normal
#PBS -l walltime=03:00:00
#PBS -l mem=384gb
#PBS -l ncpus=192
#PBS -l other=rms
#PBS -l wd
#PBS -m a
#PBS -j oe
#PBS -N wombat1p0
#PBS -lstorage=gdata/v19+scratch/v19+gdata/p93+scratch/p93+gdata/p66+gdata/p66

set -euo pipefail

# Move to directory where this script lives
repo_root=${PBS_O_WORKDIR:-$(cd "$(dirname "$0")" && pwd)}
cd "${repo_root}"

# Check that I have permissions to write here
if [[ ! -w . ]]; then
    echo "Run directory is not writable: ${repo_root}" >&2
    exit 1
fi

# Set source directories and name of MOM executable
export MOM_EXECUTABLE=${MOM_EXECUTABLE:-fms_MOM_WOMBAT.x}
export FORCING_SOURCE=${FORCING_SOURCE:-/scratch/v19/mtc599/access/jun25/work0/output}
export RUNOFF_SOURCE=${RUNOFF_SOURCE:-/g/data/v19/mtc599/mom5/jra55_clim.1990/RYF.friver.1990_1991.nc}

# Set final year of simulation to run to
endyear=${ENDYEAR:-2009}

# Ensure that we have the correct files in the correct locations
bash preflight.sh

# Read the current year from the restart file
read -r runyear _ < <(tail -n 1 RESTART/coupler.res)
if (( runyear > endyear )); then
    echo "Restart year ${runyear} is beyond ENDYEAR=${endyear}; stopping."
    exit 0
fi

# Archive some restart files at the beginning of each decade 
if [[ -f INPUT/coupler.res ]]; then
    read -r inputyear inputmonth _ < <(tail -n 1 INPUT/coupler.res)
    if (( inputmonth == 1 && inputyear % 10 == 0 )); then
        archive="restart${inputyear}"
        mkdir -p "${archive}"
        find INPUT -maxdepth 1 -type f -name '*.res*' -exec mv -n {} "${archive}/" \;
    fi
fi

if [[ -f abort ]]; then
    echo "Found abort marker; remove it only after resolving the preceding failure." >&2
    exit 1
fi

# Get the appropriate forcing files for the run year in question
(
    cd FORCING
    bash forcing_links.sh "${runyear}"
)

# Move the restart files into the INPUT directory, which is where MOM5 looks at start up
shopt -s nullglob
restart_files=(RESTART/*.res*)
if (( ${#restart_files[@]} == 0 )); then
    echo "No restart files found in RESTART." >&2
    exit 1
fi
mv "${restart_files[@]}" INPUT/

# Call the run script
bash run.pbs

