#!/bin/bash
set -euo pipefail

# Go to the current working directory of this file
repo_root=${PBS_O_WORKDIR:-$(cd "$(dirname "$0")" && pwd)}
cd "${repo_root}"

# Load modules
source /opt/Modules/v4.3.0/init/bash
module load openmpi/4.0.2
module load netcdf
module list

# Define the executable and number of CPUs
executable=${MOM_EXECUTABLE:-fms_MOM_WOMBAT.x}
npes=${PBS_NCPUS:-192}

# Check for existence of executable
[[ -x "${executable}" ]] || {
    echo "Model executable is missing or non-executable: ${executable}" >&2
    exit 1
}

mkdir -p OUTPUT RESTART
rm -f log.txt


#
##-------------------------------------------------------------------------------
## run the model with mpirun
#

# Temporarily disable the "exit on error" setting within bash
set +e
# Run MOM5 using
#   -v: verbose
#   -mca mtl '^mxm': tells open MPI not to use the mxm MTL component
#   -np "${npes}": launches the ${npes} MPI processes
#   >log.txt: write standard output to a log file
#   2>&1: sends standard error to teh same destination as standard output
mpirun -v -mca mtl '^mxm' -np "${npes}" "./${executable}" >log.txt 2>&1
# Store the exit status of the run (0 = successful)
model_status=$?
# Reset the "exit on error" setting in bash
set -e

if (( model_status != 0 )); then
    echo "MOM5 failed with exit status ${model_status}. See log.txt." >&2
    exit "${model_status}"
fi

#
##
##------------------------------------------------------------------------------
#

# Make sure restarts were created at end of model run
if [[ ! -r RESTART/coupler.res ]]; then
    echo "MOM5 returned success but did not create RESTART/coupler.res." >&2
    exit 1
fi

# Print the month at the end of the run
read -r year month _ < <(tail -n 1 INPUT/coupler.res)
printf -v month '%02d' "${month}"

# Move any existing output and place them in OUTPUT
shopt -s nullglob
outputs=(ocean*.nc* ice*.nc*)
if (( ${#outputs[@]} > 0 )); then
    mv "${outputs[@]}" OUTPUT/
fi

# Archive log file
mv log.txt "log.txt.${year}_${month}"

echo "MOM5 completed from ${year}-${month}; new restart files are in RESTART/."
